# fluxpay-backend environment. Copy to .env for local dev; set the same keys on Render for prod.
# Spring loads .env automatically (see spring.config.import in application.yml).

# --- Database (required) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fluxpay
SPRING_DATASOURCE_USERNAME=fluxpay_user
SPRING_DATASOURCE_PASSWORD=change-me

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth (required, >= 32 bytes; generate with: openssl rand -base64 48) ---
JWT_SECRET=

# --- App ---
# Origin of fluxpay-frontend (hosted checkout pages)
FLUXPAY_FRONTEND_URL=http://localhost:3000
# Comma-separated browser origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000
SHOW_SQL=false

# --- Razorpay ---
DEFAULT_GATEWAY=RAZORPAY
# Dashboard -> Account & Settings -> API Keys. rzp_test_* for test mode, rzp_live_* for live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you choose when creating the webhook (Dashboard -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=


# --- Cashfree (legacy; leave disabled) ---
CASHFREE_ENABLED=false
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=SANDBOX
